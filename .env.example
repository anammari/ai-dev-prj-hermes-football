# Hermes Football - local configuration. Copy to .env (`make setup` does it), never commit .env.
# `docker compose` reads this file directly and passes these values into the containers.

# Compose project name (default hermes-football). Only change it to give a second checkout its own
# volumes; the default keeps the existing `hermes-football_pgdata`.
# COMPOSE_PROJECT_NAME=hermes-football

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=hermes
# Host port for the db service, used only by docker-compose.dev.yml (`make db-port`). `make up`
# publishes nothing, so the stack keeps a single published port for `backend` (_docs/product-spec.md §4).
POSTGRES_PORT=5432

# In Compose, the app containers override this with host `db`. On the host, localhost is correct.
DATABASE_URL=postgresql+psycopg://hermes:change-me-locally@localhost:5432/hermes

# SQLite fallback for a dependency-free dev run (no pgvector, so no similarity search). Dev only;
# the same code path runs on both, per R-F2.3.
# DATABASE_URL=sqlite+pysqlite:///./data/hermes.db

# Read-only role for the agent-facing path. Created by the first migration; the password is only
# needed when the role must log in (the agent's own containers) rather than be SET ROLE'd in tests.
AGENT_DB_ROLE=agent_readonly
AGENT_DB_PASSWORD=change-me-locally-too
# Insert-only role for the agent's own audit row. It can write `agent_turns` and nothing else;
# created by migration 0003_agent_turn_writer.
AGENT_DB_WRITER_ROLE=agent_writer
AGENT_DB_WRITER_PASSWORD=change-me-locally-three
# UPDATE-only role behind the dashboard's review button. It may write the two review columns of
# `agent_turns` and nothing else; the agent containers never receive it. Created by migration 0004.
AGENT_ADMIN_DB_ROLE=agent_admin
AGENT_ADMIN_DB_PASSWORD=change-me-locally-four

# --- Backend (FastAPI) ---------------------------------------------------------------------------
# Bearer token for every agent-facing endpoint. There is no default: the app refuses every request
# until one is configured, so a forgotten token is a closed door rather than an open one. Generate a
# real one before exposing the stack through the tunnel: openssl rand -hex 32
API_AGENT_TOKEN=change-me-locally
# Admin token for the one write path: the review decision on an agent turn. Empty disables the
# endpoint (403) and hides the dashboard's review controls; it is never an unauthenticated door.
# Generate a real one before exposing the stack: openssl rand -hex 32
API_ADMIN_TOKEN=
# Host port for the backend (one of the two published ports; _docs/product-spec.md §4).
BACKEND_PORT=8000
# How old the newest successful ingestion of a competition may be before /meta/freshness calls it
# stale. The schedule is daily, so a day plus slack is normal, not an incident.
FRESHNESS_MAX_AGE_MINUTES=1560

# --- Local models (Ollama) ----------------------------------------------------------------------
# In Compose this is http://ollama:11434; on the host, the local Ollama server.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma:300m
# Pinned native output width of the model above (see _docs/decisions/0002). The migration pins
# vector(768) to match; a probe test fails if the two ever disagree.
OLLAMA_EMBED_DIM=768

# --- Agent routing and Telegram (M4) -----------------------------------------------------------
# The decision model is clef:cloud, reached through the signed-in host Ollama. In Compose the
# gateway reaches it on host.docker.internal; a host run uses localhost.
ROUTER_BASE_URL=http://host.docker.internal:11434
ROUTER_MODEL=clef:cloud
ROUTER_TIMEOUT_SECONDS=20
# The complex path composes with Beam in Ollama's cloud. It receives tool output and note passages;
# signed off on 2026-10-22 for complex questions only.
COMPOSER_BASE_URL=http://host.docker.internal:11434
COMPOSER_MODEL=beam:cloud
COMPOSER_TIMEOUT_SECONDS=90
# Optional: a token different from API_AGENT_TOKEN for the MCP server. Leave empty to reuse it.
MCP_SERVER_TOKEN=
# The timeout budget nests: the API's embedding deadline < the MCP server's wait for the API < the
# gateway's wait for the MCP server. A knowledge search embeds the query on local CPU and was measured
# at 13-18.5 s on the retained stack, so the old 15 s MCP->API wait made every notes question a coin
# flip (S16/S17). `tests/test_timeout_budget.py` holds the ordering.
OLLAMA_EMBED_TIMEOUT_SECONDS=40
MCP_BACKEND_TIMEOUT_SECONDS=45
MCP_TIMEOUT_SECONDS=50
# Public base for note citations: a pinned commit or tag, not a moving branch.
PUBLIC_NOTES_BASE_URL=https://github.com/anammari/ai-dev-prj-hermes-football/blob/main/hermes/agent-knowledge
# Telegram bot token from @BotFather. Leave empty and the gateway runs health-only; no bot polls.
TELEGRAM_BOT_TOKEN=
# Separate token for the public review bot (`make review-up`). Never reuse the main token.
TELEGRAM_REVIEW_BOT_TOKEN=
# Comma-separated numeric Telegram user ids. Empty refuses every message (fail closed).
# Get your numeric id from @userinfobot first, allowlist it, then /id works in the bot.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ADMIN_USERS=
# Public review bot limits. The main bot keeps allow-all off.
TELEGRAM_ALLOW_ALL_USERS=false
TELEGRAM_MIN_INTERVAL_SECONDS=0
TELEGRAM_MAX_MESSAGE_CHARS=500
TELEGRAM_REVIEW_MIN_INTERVAL_SECONDS=5
TELEGRAM_REVIEW_MAX_MESSAGE_CHARS=500
# Salt for the chat-id hash stored with a turn. Never the raw chat id.
CHAT_HASH_SALT=change-me-locally
# The gateway composes AGENT_TURN_DSN from the writer role and password above; do not set it here.

# --- Dashboard (M5) -----------------------------------------------------------------------------
# Host port for the Next.js dashboard, the second and last published port. The browser never holds
# API_AGENT_TOKEN or API_ADMIN_TOKEN: the dashboard fetches server-side, like the agent does.
FRONTEND_PORT=3000
# Show the stored Telegram message text on the audit page. Off by default: the public review bot's
# traffic is in `agent_turns`, and a tunnel is demo-only. The full text stays in the audit API.
DASHBOARD_SHOW_MESSAGES=false

# --- Golden-question evaluation (M5) ------------------------------------------------------------
# `make eval` answers every question in evals/golden/ through the shipped pipeline and stores the run
# in Postgres plus an artifact under evals/golden/runs/. The gate is routing macro-F1 >= the target,
# all safety gates, retrieval recall and fact coverage floors; all of it is in evals/golden/README.md.
EVAL_MIN_MACRO_F1=0.90
EVAL_MIN_RETRIEVAL_RECALL=0.90
EVAL_MIN_FACT_COVERAGE=0.90

# --- Knowledge corpus ---------------------------------------------------------------------------
KNOWLEDGE_DIR=hermes/agent-knowledge

# --- Upstream football API (used from M2 onwards) -----------------------------------------------
UPSTREAM_BASE_URL=https://api.football-data.org/v4
UPSTREAM_API_KEY=replace-with-your-football-data-org-token

# Daily ingest schedule, in the timezone below.
INGEST_SCHEDULE_HOUR=2
INGEST_SCHEDULE_MINUTE=0
INGEST_TIMEZONE=UTC
# Bronze (raw_payloads) retention in days; payloads older than this are pruned at the end of each run.
RAW_PAYLOAD_RETENTION_DAYS=30

# --- Observability (M6) -------------------------------------------------------------------------
# Telemetry is push-only and off unless this endpoint is set. `make obs-up` exports it as
# http://otel-collector:4318 and recreates the app containers; `make obs-down` removes it again.
# Nothing outside the Compose network receives a trace, metric or log.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Fraction of traces sampled (0.0-1.0). This stack is low-traffic, so sample everything: a manual
# inspection always finds the request it just made. Lower to 0.1 on a busier host.
OTEL_TRACES_SAMPLER_ARG=1.0
# Grafana is bound to 127.0.0.1 only and runs as an anonymous viewer: never tunnel it.
GRAFANA_PORT=3001

# --- On-call agent and alerting (M6) ------------------------------------------------------------
# The oncall container reads the ledger through agent_readonly (ONCALL_DB_DSN is built in Compose)
# and writes a daily digest plus alert state to its own volume. It never writes the database.
ONCALL_STALE_MINUTES=1560
ONCALL_CONSECUTIVE_FAILURES=2
ONCALL_REQUIRED_BREACHES=2
ONCALL_RUNNING_STALE_HOURS=3
ONCALL_CHECK_SECONDS=60
ONCALL_DIGEST_HOUR=7
ONCALL_TIMEZONE=UTC
ONCALL_EVAL_MAX_AGE_DAYS=8
# Owner-Telegram alert delivery is a separate, opt-in egress path (decision 0010). Off by default;
# when enabled it sends only the fixed template built from counters and timestamps, never user text,
# notes or prompts. Use a separate bot token, never the main or review bot token.
ALERT_TELEGRAM_ENABLED=false
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
