# Hermes Football - local configuration. Copy to .env (`make setup` does it), never commit .env.
# `docker compose` reads this file directly and passes these values into the containers.

# Compose project name (default hermes-football). Only change it to give a second checkout its own
# volumes; the default keeps the existing `hermes-football_pgdata`.
# COMPOSE_PROJECT_NAME=hermes-football

# --- Database ---------------------------------------------------------------------------------
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=hermes
# Host port for the db service, used only by docker-compose.dev.yml (`make db-port`). `make up`
# publishes nothing, so the stack keeps a single published port for `backend` (_docs/product-spec.md §4).
POSTGRES_PORT=5432

# In Compose, the app containers override this with host `db`. On the host, localhost is correct.
DATABASE_URL=postgresql+psycopg://hermes:change-me-locally@localhost:5432/hermes

# SQLite fallback for a dependency-free dev run (no pgvector, so no similarity search). Dev only;
# the same code path runs on both, per R-F2.3.
# DATABASE_URL=sqlite+pysqlite:///./data/hermes.db

# Read-only role for the agent-facing path. Created by the first migration; the password is only
# needed when the role must log in (the agent's own containers) rather than be SET ROLE'd in tests.
AGENT_DB_ROLE=agent_readonly
AGENT_DB_PASSWORD=change-me-locally-too

# --- Local models (Ollama) ----------------------------------------------------------------------
# In Compose this is http://ollama:11434; on the host, the local Ollama server.
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=embeddinggemma:300m
# Pinned native output width of the model above (see _docs/decisions/0002). The migration pins
# vector(768) to match; a probe test fails if the two ever disagree.
OLLAMA_EMBED_DIM=768

# --- Knowledge corpus ---------------------------------------------------------------------------
KNOWLEDGE_DIR=hermes/agent-knowledge

# --- Upstream football API (used from M2 onwards) -----------------------------------------------
UPSTREAM_BASE_URL=https://api.football-data.org/v4
UPSTREAM_API_KEY=replace-with-your-football-data-org-token

# Daily ingest schedule, in the timezone below.
INGEST_SCHEDULE_HOUR=2
INGEST_SCHEDULE_MINUTE=0
INGEST_TIMEZONE=UTC
# Bronze (raw_payloads) retention in days; payloads older than this are pruned at the end of each run.
RAW_PAYLOAD_RETENTION_DAYS=30
