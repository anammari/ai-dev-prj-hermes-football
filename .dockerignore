# Keep the build context small, and keep secrets and local state out of the image.
.env
.env.*
!.env.example
.git/
.venv/
.uv-cache/
data/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.db

# The dashboard's build context is the repository root (the API types come from openapi.yaml), so keep
# its local install and build output out of every image.
frontend/node_modules/
frontend/.next/
frontend/playwright-report/
frontend/test-results/
